*.log
*.session
# Crash telemetry and Python runtime caches are machine-local.
.sentry-native/
__pycache__/
*.py[cod]
nvim/.config/nvim/lua/local.lua
tmux/.config/tmux/local.conf
zsh/.config/zsh/local.zsh
yazi/.config/yazi/bookmark
# Sunshine keeps pairing credentials and runtime state beside its config.
sunshine/.config/sunshine/credentials/
sunshine/.config/sunshine/sunshine_state.json
sunshine/.config/sunshine/*.log*
sunshine/.config/sunshine/*.bak
# VLC's UI state records recently opened local media.
vlc/.config/vlc/vlc-qt-interface.conf
vlc/.config/vlc/ml.xspf
